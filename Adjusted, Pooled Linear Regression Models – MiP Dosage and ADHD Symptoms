# ============================================================
# Script Name: Adjusted, Pooled Linear Regression Models – MiP Dosage and ADHD Symptoms
# Author: Katharine Barry
# Date: 2025-06-02
# Description: Examines whether the number of malaria episodes during pregnancy 
# is associated with ADHD symptom scores at 6 years of age. Includes both 
# unadjusted and adjusted pooled linear regression models using imputed data.
# ============================================================


# load libraries
#-------------------------------------------------------------------------------
library(mice)
library(mitools)   # For pooling results
library(broom)     # For tidy model output
library(dplyr)     # For data manipulation

#-------------------------------------------------------------------------------
# run unadjusted linear regression models for ADHD symptoms
# malaria dosage in 5 categories 
#-------------------------------------------------------------------------------

unadjusted_dose_pooled_ADHD <- with(imp, lm(as.formula("EXP_scoreADHD ~ malaria_dose_5cat")))


summary(pool(unadjusted_dose_pooled_ADHD))

#-------------------------------------------------------------------------------
# calculate 95% CI

# Extract summary of pooled results
pooled_unadjusted_dose_ADHD <- summary(pool(unadjusted_dose_pooled_ADHD))

# Manually compute 95% CI
pooled_unadjusted_dose_ADHD <- pooled_unadjusted_dose_ADHD%>%
  mutate(lower_95CI = estimate - 1.96 * std.error,
         upper_95CI = estimate + 1.96 * std.error)

# Print results with confidence intervals
print(pooled_unadjusted_dose_ADHD)


#-------------------------------------------------------------------------------
# run adjusted linear regression models for ADHD symptoms
# malaria dosage in 5 categories 
#-------------------------------------------------------------------------------


adjdose_pooled_ADHD <- with(imp, lm(as.formula("EXP_scoreADHD ~ malaria_dose_5cat + 
                                        age_at_delivery + v01bas_gravidity_cat + pre_pregnancy_BMI + 
                                        v01med_iptpgroup_1 + ID_visit1   + 
                                        mother_edu_1year + TOV_stot  + helminth_inf1")))


summary(pool(adjdose_pooled_ADHD))

#-------------------------------------------------------------------------------
# calculate 95% CI

# Extract summary of pooled results
pooled_adjdose_ADHD <- summary(pool(adjdose_pooled_ADHD))

# Manually compute 95% CI
pooled_adjdose_ADHD <- pooled_adjdose_ADHD %>%
  mutate(lower_95CI = estimate - 1.96 * std.error,
         upper_95CI = estimate + 1.96 * std.error)

# Print results with confidence intervals
print(pooled_adjdose_ADHD)


