# ==============================================================================
# Title: SDQ Coding for 6-Year-Olds (EXPLORE Dataset)
# Project: The effects of malaria in pregnancy on children’s socio-emotional 
#          development at 6 years of age in Benin
# Author: Katharine Barry
# Date: 2024-11-19
# Purpose: Clean and score Strengths and Difficulties Questionnaire (SDQ) items
# ==============================================================================

library(dplyr)
library(tidyr)

# ---- Step 1: Rename SDQ items to sdq6ans_1 to sdq6ans_25 ----
original_vars <- c("EXP_v843", "EXP_v844", "EXP_v845", "EXP_v846", "EXP_v847",
                   "EXP_v848", "EXP_v849", "EXP_v850", "EXP_v851", "EXP_v852",
                   "EXP_v853", "EXP_v854", "EXP_v855", "EXP_v856", "EXP_v857",
                   "EXP_v858", "EXP_v859", "EXP_v860", "EXP_v861", "EXP_v862",
                   "EXP_v863", "EXP_v864", "EXP_v865", "EXP_v866", "EXP_v867")

Explore <- Explore %>%
  rename_with(.cols = all_of(original_vars), .fn = ~ paste0("sdq6ans_", seq_along(.)))

# ---- Step 2: Clean unexpected values ----
# Remove responses coded as 'O' in item 22 (should not exist)
Explore <- Explore %>%
  filter(is.na(sdq6ans_22) | sdq6ans_22 != "O")

# ---- Step 3: Recode responses from character to numeric ----
# Original coding: P = 0 (Not true), U = 1 (Somewhat true), T = 2 (Certainly true)
Explore <- Explore %>%
  mutate(across(starts_with("sdq6ans_"),
                ~ case_when(
                  . == "P" ~ 0,
                  . == "U" ~ 1,
                  . == "T" ~ 2,
                  TRUE ~ NA_real_
                )))

# ---- Step 4: Reverse-code selected items ----
# Items: 7, 11, 14, 19, 25
Explore <- Explore %>%
  mutate(
    sdq6ans_7  = 2 - sdq6ans_7,   # Generally obedient
    sdq6ans_11 = 2 - sdq6ans_11,  # Has at least one good friend
    sdq6ans_14 = 2 - sdq6ans_14,  # Picked on/bullied
    sdq6ans_19 = 2 - sdq6ans_19,  # Generally liked
    sdq6ans_25 = 2 - sdq6ans_25   # Thinks before acting
  )

# ---- Step 5: Compute SDQ Subscales ----
Explore <- Explore %>%
  mutate(
    sdq6ans_emotional    = rowSums(across(c(sdq6ans_3, sdq6ans_8, sdq6ans_13, sdq6ans_16, sdq6ans_24)), na.rm = TRUE),
    sdq6ans_conduct      = rowSums(across(c(sdq6ans_5, sdq6ans_7, sdq6ans_12, sdq6ans_18, sdq6ans_22)), na.rm = TRUE),
    sdq6ans_hyperactive  = rowSums(across(c(sdq6ans_2, sdq6ans_10, sdq6ans_15, sdq6ans_21, sdq6ans_25)), na.rm = TRUE),
    sdq6ans_peerproblems = rowSums(across(c(sdq6ans_6, sdq6ans_11, sdq6ans_14, sdq6ans_19, sdq6ans_23)), na.rm = TRUE),
    sdq6ans_prosocial    = rowSums(across(c(sdq6ans_1, sdq6ans_4, sdq6ans_9, sdq6ans_17, sdq6ans_20)), na.rm = TRUE)
  )

# ---- Step 6: Compute Internalizing, Externalizing, and Total SDQ Scores ----
Explore <- Explore %>%
  mutate(
    sdq6ans_internalizing = sdq6ans_emotional + sdq6ans_peerproblems,
    sdq6ans_externalizing = sdq6ans_conduct + sdq6ans_hyperactive,
    sdq6ans_totalsdq      = sdq6ans_emotional + sdq6ans_conduct + sdq6ans_hyperactive + sdq6ans_peerproblems
  )

# ---- Step 7: Check final variables ----
summary(select(Explore, sdq6ans_internalizing, sdq6ans_externalizing, sdq6ans_totalsdq))
