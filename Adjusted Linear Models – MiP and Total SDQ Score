# Description: Pooling adjusted linear regression results using 
# multiple imputation for total SDQ difficulties at 6 years
# ============================================================

# ------------------------
# Load required libraries
# ------------------------
library(mice)
library(mitools)
library(broom)
library(dplyr)

# ------------------------
# Define a helper function to run and summarize models
# ------------------------
run_pooled_model <- function(formula, data, label) {
  model <- with(data, lm(as.formula(formula)))
  pooled <- summary(pool(model)) %>%
    mutate(lower_95CI = estimate - 1.96 * std.error,
           upper_95CI = estimate + 1.96 * std.error,
           model = label)
  return(pooled)
}

# ------------------------
# Define model formulas for each exposure
# ------------------------
base_covariates <- "age_at_delivery + v01bas_gravidity_cat + pre_pregnancy_BMI + 
                    v01med_iptpgroup_1 + ID_visit1 + mother_edu_1year + TOV_stot + helminth_inf1"

formulas <- list(
  ANV1        = paste("sdq6ans_totalsdq ~ ANV1_malaria +", base_covariates),
  ANV3        = paste("sdq6ans_totalsdq ~ ANV3_malaria +", base_covariates, "+ malaria_pre_birth"),
  PCR         = paste("sdq6ans_totalsdq ~ PCR_malaria +", base_covariates, "+ malaria_pre_birth"),
  Placenta    = paste("sdq6ans_totalsdq ~ PCR_placenta +", base_covariates, "+ malaria_pre_birth"),
  MiP         = paste("sdq6ans_totalsdq ~ MiP +", base_covariates),
  BirthMal    = paste("sdq6ans_totalsdq ~ birth_malaria + malaria_pre_birth +", base_covariates)
)

# ------------------------
# Run models and store results
# ------------------------
results <- lapply(names(formulas), function(name) {
  run_pooled_model(formulas[[name]], imp, label = name)
})

# Combine all results into one data frame
all_results <- bind_rows(results)

# ------------------------
# Display results
# ------------------------
print(all_results)
