# ==============================================================================
# Title: Multiple Imputation for Malaria in Pregnancy and SDQ Scores
# Project: The effects of malaria in pregnancy on children’s socio-emotional 
#          development at 6 years of age in Benin
# Author: Katharine Barry
# Date: 2025-01-27
# Purpose: Impute missing covariates using MICE for analysis population
# ==============================================================================

library(dplyr)
library(mice)
library(tidyr)

# ------------------------------------------------------------------------------
# Step 1: Select relevant variables
# ------------------------------------------------------------------------------

malaria_data <- malaria_sdq_pop %>%
  select(midm, mide, age_at_delivery, v01bas_gravidity_cat, pre_pregnancy_BMI, 
         v01med_iptpgroup_1, CRP_first_visit, ID_visit1, mother_edu_1year, TOV_stot, 
         sdq6ans_totalsdq, TOV_epdstot, TOV_hometot, preterm_birth, 
         MSE_v01bir_bweight_5, sdq6ans_internalizing, sdq6ans_externalizing,
         EXP_scoreADHD, child_sex, ANV1_malaria, ANV2_malaria, ANV3_malaria, 
         PCR_malaria, PCR_placenta, MiP, AME_DPFalciparum1, AME_DPFalciparum2, 
         AME_DPFalciparum3, MSE_v01bir_length_6, MSE_v01bir_headcir_7, 
         MSE_v01bir_axtemp_8, helminth_inf1, malaria_pre_birth, birth_malaria, 
         malaria_dose, malaria_dose_3cat, malaria_dose_4cat, malaria_dose_5cat)

# ------------------------------------------------------------------------------
# Step 2: Set data types
# ------------------------------------------------------------------------------

malaria_data <- malaria_data %>%
  mutate(
    across(c(CRP_first_visit, ID_visit1, mother_edu_1year, 
             v01bas_gravidity_cat, v01med_iptpgroup_1, 
             ANV1_malaria, ANV2_malaria, ANV3_malaria, PCR_malaria, 
             PCR_placenta, MiP, helminth_inf1, preterm_birth, 
             malaria_pre_birth, birth_malaria, child_sex), as.factor),
    across(c(sdq6ans_internalizing, sdq6ans_externalizing, EXP_scoreADHD, TOV_stot), as.numeric)
  )

# Clean non-numeric child anthropometry values
malaria_data <- malaria_data %>%
  mutate(across(c(MSE_v01bir_length_6, MSE_v01bir_headcir_7, MSE_v01bir_axtemp_8), 
                ~ as.numeric(gsub(",", ".", na_if(., ".u")))))

# ------------------------------------------------------------------------------
# Step 3: Define Imputation Strategy
# ------------------------------------------------------------------------------

# ✅ Variables to be imputed
imputed_vars <- c("age_at_delivery", "mother_edu_1year", "TOV_stot", 
                  "MSE_v01bir_bweight_5", "child_sex", "helminth_inf1")

# 🚫 Variables completely excluded from imputation and prediction
exclude_vars <- c("midm", "mide", "sdq6ans_totalsdq", "EXP_scoreADHD", "birth_malaria",
                  "AME_DPFalciparum1", "AME_DPFalciparum2", "AME_DPFalciparum3",
                  "malaria_dose_5cat", "malaria_dose_4cat", "malaria_dose_3cat", "malaria_dose",
                  "TOV_epdstot", "TOV_hometot", "PCR_placenta", "ANV1_malaria", "ANV2_malaria",
                  "ANV3_malaria", "PCR_malaria", "malaria_pre_birth")

# ➕ Predictors-only variables
predictors_only <- c("MSE_v01bir_length_6", "MSE_v01bir_headcir_7", "MSE_v01bir_axtemp_8", 
                     "sdq6ans_internalizing", "sdq6ans_externalizing", "MiP", 
                     "pre_pregnancy_BMI", "CRP_first_visit", "ID_visit1", "preterm_birth")

# ------------------------------------------------------------------------------
# Step 4: Define Imputation Methods
# ------------------------------------------------------------------------------

method <- rep("", ncol(malaria_data))
names(method) <- colnames(malaria_data)

# Assign specific imputation methods
method[c("mother_edu_1year", "child_sex", "CRP_first_visit", "ID_visit1", 
         "preterm_birth", "helminth_inf1", "MiP")] <- "logreg"

method[c("TOV_stot", "MSE_v01bir_bweight_5", "age_at_delivery", 
         "pre_pregnancy_BMI", "MSE_v01bir_length_6", 
         "MSE_v01bir_headcir_7", "MSE_v01bir_axtemp_8", 
         "sdq6ans_internalizing", "sdq6ans_externalizing")] <- "norm"

# Prevent imputation for excluded vars
method[exclude_vars] <- ""

# ------------------------------------------------------------------------------
# Step 5: Create Predictor Matrix
# ------------------------------------------------------------------------------

predictorMatrix <- make.predictorMatrix(malaria_data)

# Remove excluded variables
predictorMatrix[exclude_vars, ] <- 0
predictorMatrix[, exclude_vars] <- 0

# Use predictors-only variables (but don’t impute them)
predictorMatrix[predictors_only, ] <- 0
predictorMatrix[, predictors_only] <- 1

# Force strong predictor sets
predictorMatrix["mother_edu_1year", ] <- 0
predictorMatrix["mother_edu_1year", c("age_at_delivery", "pre_pregnancy_BMI", 
                                      "CRP_first_visit", "ID_visit1", "preterm_birth",
                                      "helminth_inf1", "TOV_stot", "sdq6ans_internalizing",
                                      "sdq6ans_externalizing", "MiP")] <- 1

predictorMatrix["TOV_stot", ] <- 0
predictorMatrix["TOV_stot", c("pre_pregnancy_BMI", "CRP_first_visit", "sdq6ans_internalizing",
                              "sdq6ans_externalizing", "helminth_inf1", "mother_edu_1year", 
                              "MSE_v01bir_length_6", "MSE_v01bir_headcir_7", "MSE_v01bir_axtemp_8",
                              "MiP", "age_at_delivery")] <- 1

predictorMatrix["MSE_v01bir_bweight_5", ] <- 0
predictorMatrix["MSE_v01bir_bweight_5", c("age_at_delivery", "pre_pregnancy_BMI", "preterm_birth",
                                          "helminth_inf1", "ID_visit1", "CRP_first_visit", 
                                          "MSE_v01bir_length_6", "MSE_v01bir_headcir_7", 
                                          "MSE_v01bir_axtemp_8", "MiP")] <- 1

predictorMatrix["child_sex", ] <- 0
predictorMatrix["child_sex", c("age_at_delivery", "MSE_v01bir_length_6", "MSE_v01bir_headcir_7",
                               "MSE_v01bir_axtemp_8", "preterm_birth", "pre_pregnancy_BMI",
                               "ID_visit1", "sdq6ans_internalizing", "sdq6ans_externalizing", "MiP")] <- 1

predictorMatrix["helminth_inf1", ] <- 0
predictorMatrix["helminth_inf1", c("pre_pregnancy_BMI", "CRP_first_visit", "TOV_stot", "mother_edu_1year",
                                   "sdq6ans_internalizing", "sdq6ans_externalizing", "MiP", 
                                   "age_at_delivery", "ID_visit1")] <- 1

predictorMatrix["age_at_delivery", ] <- 0
predictorMatrix["age_at_delivery", c("MSE_v01bir_bweight_5", "mother_edu_1year", "pre_pregnancy_BMI", 
                                     "preterm_birth", "helminth_inf1", "ID_visit1", 
                                     "CRP_first_visit", "MiP")] <- 1

# ------------------------------------------------------------------------------
# Step 6: Run MICE Imputation
# ------------------------------------------------------------------------------

imp <- mice(malaria_data, m = 10, maxit = 5, method = method, 
            predictorMatrix = predictorMatrix, seed = 123)

# Verify missing values are filled
sapply(imputed_vars, function(var) sum(is.na(complete(imp, 1)[[var]])))

# Export long-format imputed data
imputed_long <- complete(imp, "long")
write.csv(imputed_long, "imputed_data_long.csv", row.names = FALSE)
