# ==============================================================================
# Title: Study Population Construction for Malaria and Socio-Emotional Outcomes
# Project: The effects of malaria in pregnancy on children’s socio-emotional 
#          development at 6 years of age in Benin: A prospective mother–child cohort
# Author: Katharine Barry
# Date: 2025-01-15
# Purpose: Create analysis population and document exclusion reasons
# ==============================================================================

library(dplyr)

# ---- Step 1: Total mothers enrolled in MiPPAD ----
num_mothers_MiPPAD <- tabmev5_kb %>%
  summarise(unique_mothers = n_distinct(midm))
print(num_mothers_MiPPAD)  # 1183 mothers

# ---- Step 2: Mothers included in APEC nested study ----
num_mothers_apec <- tabmev5_kb %>%
  filter(i_GEAP == 1) %>%
  summarise(unique_mothers_apec = n_distinct(midm))
print(num_mothers_apec)  # 1005 mothers

# ---- Step 3: Birth outcomes classification ----
tabmev5_kb <- tabmev5_kb %>%
  mutate(birth_outcome = case_when(
    v05del_delivoutc_7 == "Live birt" ~ "Live Birth",
    v05del_delivoutc_7 == "Stillbirt" ~ "Still Birth",
    v05del_delivoutc_7 %in% c("Spontaneo", "Other") ~ "Abortion",
    v05del_delivoutc_7 %in% c(".i", ".a") ~ NA_character_
  ))

# Summary of birth outcomes (distinct mothers only)
birth_outcome_summary <- tabmev5_kb %>%
  distinct(midm, .keep_all = TRUE) %>%
  group_by(birth_outcome) %>%
  summarise(count = n())
print(birth_outcome_summary)
# → 1059 Live Births, 42 Stillbirths, 10 Abortions, 72 Missing

# ---- Step 4: Reason for non-completion of study ----
table(
  tabmev5_kb %>% distinct(midm, .keep_all = TRUE) %>%
    select(vxxstu_notcompletersn_5, v05del_delivoutc_7),
  useNA = "ifany"
)

# ---- Step 5: Create base APEC dataset (distinct mothers) ----
APEC <- tabmev5_kb %>%
  filter(!is.na(i_GEAP)) %>%
  distinct(midm, .keep_all = TRUE)

# ---- Step 6: Handle multiple pregnancies ----
mothers_with_twins <- APEC %>%
  filter(v05del_multbirth_10 == "Yes") %>%
  distinct(midm)
# → 28 mothers with multiple pregnancies

APEC_notwins <- APEC %>%
  filter(v05del_multbirth_10 != "Yes")  # 974 singleton pregnancies

# ---- Step 7: Exclude problematic cases (identified by Amanda) ----
APEC_noprob <- APEC_notwins %>%
  filter(is.na(excl_Amanda) | excl_Amanda != 1)  # 967 children

# ---- Step 8: Explore child mortality inconsistencies ----
table(APEC_noprob$DEC_apec1)  # Christophe: 14 deaths; Melissa: 65

# ---- Step 9: Define study population with EXPLORE visit ----
Explore <- APEC_noprob %>%
  filter(i_EXPL == 1)  

# ---- Step 10: Final population with SDQ & malaria data ----
APEC_explore_comp <- Explore %>%
  filter(
    !is.na(sdq6ans_internalizing),
    !is.na(sdq6ans_externalizing),
    !is.na(ANV1_malaria),
    !is.na(ANV2_malaria),
    !is.na(ANV3_malaria),
    !is.na(PCR_malaria),
    !is.na(PCR_placenta)
  )

# Export cleaned dataset
write.csv(APEC_explore_comp, "malaria_sdq_pop.csv", row.names = FALSE)

# ---- Step 11: Remove coding errors (outliers) ----
malaria_sdq_pop <- APEC_explore_comp %>%
  filter(!(mide %in% c(X, XX)))  # Remove 2 outliers

# Final sample: 503 children
write.csv(malaria_sdq_pop, "malaria_sdq_pop.csv", row.names = FALSE)
