# Description: Pooling adjusted linear regression results using 
# multiple imputation for ADHD-related TOVA scores at 6 years
# ============================================================

# ------------------------
# Load required libraries
# ------------------------
library(mice)
library(mitools)
library(broom)
library(dplyr)

# ------------------------
# Helper function to run and summarize pooled models
# ------------------------
run_pooled_model <- function(formula, data, label) {
  model <- with(data, lm(as.formula(formula)))
  pooled <- summary(pool(model)) %>%
    mutate(lower_95CI = estimate - 1.96 * std.error,
           upper_95CI = estimate + 1.96 * std.error,
           model = label)
  return(pooled)
}

# ------------------------
# Define base covariates
# ------------------------
base_covariates <- "age_at_delivery + v01bas_gravidity_cat + pre_pregnancy_BMI + 
                    v01med_iptpgroup_1 + ID_visit1 + mother_edu_1year + TOV_stot + helminth_inf1"

# ------------------------
# Define model formulas
# ------------------------
formulas <- list(
  ANV1        = paste("EXP_scoreADHD ~ ANV1_malaria +", base_covariates),
  ANV3        = paste("EXP_scoreADHD ~ ANV3_malaria +", base_covariates, "+ malaria_pre_birth"),
  PCR         = paste("EXP_scoreADHD ~ PCR_malaria +", base_covariates, "+ malaria_pre_birth"),
  BirthMal    = paste("EXP_scoreADHD ~ birth_malaria +", base_covariates, "+ malaria_pre_birth"),
  Placenta    = paste("EXP_scoreADHD ~ PCR_placenta +", base_covariates, "+ malaria_pre_birth"),
  MiP_adj     = paste("EXP_scoreADHD ~ MiP +", base_covariates),
  MiP_unadj   = "EXP_scoreADHD ~ MiP"
)

# ------------------------
# Run and combine all results
# ------------------------
results <- lapply(names(formulas), function(name) {
  run_pooled_model(formulas[[name]], imp, label = name)
})

# Combine into one data frame
all_results <- bind_rows(results)

# ------------------------
# Display results
# ------------------------
print(all_results)
