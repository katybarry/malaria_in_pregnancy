# ==============================================================================
# Title: Malaria Exposure Variable Construction
# Project: The effects of malaria in pregnancy on children’s socio-emotional 
#          development at 6 years of age in Benin
# Author: Katharine Barry
# Date: 2025-XX-XX
# Purpose: Create and summarize malaria exposure variables during pregnancy
# ==============================================================================

library(dplyr)
library(gtsummary)
library(gt)

# ------------------------------------------------------------------------------
# Step 1: Recode Malaria Diagnostics at Prenatal Visits (1st, 2nd, 3rd)
# ------------------------------------------------------------------------------

Explore <- Explore %>%
  mutate(
    ANV1_malaria = case_when(AME_GEResultat1 == 1 ~ 0,
                             AME_GEResultat1 == 2 ~ 1,
                             TRUE ~ NA_real_),
    ANV2_malaria = case_when(AME_GEResultat2 == 1 ~ 0,
                             AME_GEResultat2 == 2 ~ 1,
                             TRUE ~ NA_real_),
    ANV3_malaria = case_when(AME_GEResultat3 == 1 ~ 0,
                             AME_GEResultat3 == 2 ~ 1,
                             TRUE ~ NA_real_)
  )

# ------------------------------------------------------------------------------
# Step 2: PCR Results at Birth
# ------------------------------------------------------------------------------

Explore <- Explore %>%
  mutate(
    PCR_malaria1 = case_when(AME_PCR_Acc1 == "pos" ~ 1,
                             AME_PCR_Acc1 == "neg" ~ 0,
                             TRUE ~ NA_real_),
    PCR_malaria2 = case_when(AME_PCR_Acc2 == "pos" ~ 1,
                             TRUE ~ NA_real_),
    PCR_malaria = case_when(
      PCR_malaria1 == 1 | PCR_malaria2 == 1 ~ 1,
      PCR_malaria1 == 0 & (is.na(PCR_malaria2) | PCR_malaria2 == 0) ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Step 3: PCR on Placenta (Placental Malaria)
# ------------------------------------------------------------------------------

Explore <- Explore %>%
  mutate(
    PCR_plac1 = case_when(AME_PCR_Plac1 == "pos" ~ 1,
                          AME_PCR_Plac1 == "neg" ~ 0,
                          TRUE ~ NA_real_),
    PCR_plac2 = case_when(AME_PCR_Plac2 == "pos" ~ 1,
                          AME_PCR_Plac2 == "neg" ~ 0,
                          TRUE ~ NA_real_),
    PCR_placenta = case_when(
      PCR_plac1 == 1 | PCR_plac2 == 1 ~ 1,
      PCR_plac1 == 0 & (is.na(PCR_plac2) | PCR_plac2 == 0) ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Step 4: Create Summary Variables
# ------------------------------------------------------------------------------

# Exposure at any of the three prenatal visits
Explore <- Explore %>%
  mutate(
    malaria_three_visits = case_when(
      ANV1_malaria == 1 | ANV2_malaria == 1 | ANV3_malaria == 1 ~ 1,
      ANV1_malaria == 0 &
        (is.na(ANV2_malaria) | ANV2_malaria == 0) &
        (is.na(ANV3_malaria) | ANV3_malaria == 0) ~ 0,
      TRUE ~ NA_real_
    ),
    
    ANV3_pcr_malaria = case_when(
      malaria_three_visits == 1 | PCR_malaria == 1 ~ 1,
      malaria_three_visits == 0 & (PCR_malaria == 0 | is.na(PCR_malaria)) ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Step 5: Emergency Visits
# ------------------------------------------------------------------------------

Explore <- Explore %>%
  mutate(
    AME_GE1_recode = ifelse(AME_GE1 == 2, 0, AME_GE1),
    AME_GE2_recode = ifelse(AME_GE2 == 2, 0, AME_GE2),
    AME_GE3_recode = ifelse(AME_GE3 == 2, 0, AME_GE3),
    AME_GE4_recode = ifelse(AME_GE4 == 2, 0, AME_GE4),
    
    malaria_emerg = case_when(
      AME_GE1_recode == 1 | AME_GE2_recode == 1 | 
        AME_GE3_recode == 1 | AME_GE4_recode == 1 ~ 1,
      AME_GE1_recode == 0 & AME_GE2_recode == 0 &
        AME_GE3_recode == 0 & AME_GE4_recode == 0 ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Step 6: Combined Malaria Exposure Variables
# ------------------------------------------------------------------------------

Explore <- Explore %>%
  mutate(
    MiP_noplac = case_when(
      ANV3_pcr_malaria == 1 | malaria_emerg == 1 ~ 1,
      ANV3_pcr_malaria == 0 & is.na(malaria_emerg) ~ 0,
      TRUE ~ NA_real_
    ),
    
    MiP = case_when(
      MiP_noplac == 1 | PCR_placenta == 1 ~ 1,
      MiP_noplac == 0 & (is.na(PCR_placenta) | PCR_placenta == 0) ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Step 7: Summary Table of Malaria Exposure Variables
# ------------------------------------------------------------------------------

summary_table <- Explore %>%
  select(ANV1_malaria, ANV2_malaria, ANV3_malaria, PCR_malaria,
         malaria_three_visits, ANV3_pcr_malaria, malaria_emerg,
         MiP_noplac, MiP) %>%
  tbl_summary(
    statistic = all_categorical() ~ "{n} ({p}%)",
    label = list(
      ANV1_malaria ~ "Malaria (Visit 1)",
      ANV2_malaria ~ "Malaria (Visit 2)",
      ANV3_malaria ~ "Malaria (Visit 3)",
      PCR_malaria ~ "PCR Malaria (At Birth)",
      malaria_three_visits ~ "Malaria (Any Visit)",
      ANV3_pcr_malaria ~ "Malaria (Visits + PCR)",
      malaria_emerg ~ "Malaria Emergency Visit",
      MiP_noplac ~ "MiP (Visits + PCR + Emerg)",
      MiP ~ "MiP (Visits + PCR + Emerg + Placenta)"
    ),
    missing = "ifany"
  ) %>%
  add_n()

# Export table
summary_table %>%
  as_gt() %>%
  gtsave("Malaria_exposure_summary.docx")

# ------------------------------------------------------------------------------
# Step 8: Save Final Dataset
# ------------------------------------------------------------------------------

write.csv(Explore, "Explore.csv", row.names = FALSE)
