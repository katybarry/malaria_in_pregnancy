# ==============================================================================
# Title: Covariates, Moderators, and Mediators Coding
# Project: The effects of malaria in pregnancy on children’s socio-emotional 
#          development at 6 years of age in Benin
# Author: Katharine Barry
# Date: 2025-01-23
# Purpose: Create and clean all covariates and derived variables
# ==============================================================================

library(dplyr)
library(forcats)
library(tidyr)

# ------------------------------------------------------------------------------
# Maternal Sociodemographic and Pregnancy Covariates
# ------------------------------------------------------------------------------

# Age at delivery (in years)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(age_at_delivery = as.numeric(difftime(as.Date(v05del_delivdate_4m),
                                               as.Date(AME_DateNaiss),
                                               units = "days")) / 365.25,
         age_at_delivery = ifelse(age_at_delivery < 5, NA, age_at_delivery))
summary(malaria_sdq_pop$age_at_delivery)

# Gravidity
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(v01bas_gravidity_cat = factor(v01bas_gravidity_cat,
                                       levels = c("Primigravidae", "1-3 previous", "4 or more")))

# Pre-pregnancy BMI (based on Ouedraogo 2012)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    AME_Taille_m = AME_Taille / 100,
    weeks_after_first_trimester = pmax(AME_AgeGesta - 12, 0),
    months_after_first_trimester = weeks_after_first_trimester / 4.345,
    estimated_weight_gain = months_after_first_trimester * 1,
    pre_pregnancy_weight = AME_Poids - estimated_weight_gain,
    pre_pregnancy_BMI = pre_pregnancy_weight / (AME_Taille_m ^ 2)
  )
summary(malaria_sdq_pop$pre_pregnancy_BMI)

# IPTp group
table(malaria_sdq_pop$v01med_iptpgroup_1, useNA = "ifany")

# Education (1 = any schooling; 0 = none)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(mother_edu_1year = case_when(
    TOV_scol == 0 ~ 0,
    TOV_scol %in% 1:3 ~ 1,
    TRUE ~ NA_real_
  ))

# ------------------------------------------------------------------------------
# Maternal Inflammation & Iron Deficiency
# ------------------------------------------------------------------------------

# CRP elevation: > 5 mg/L
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    CRP_first_visit = if_else(AME_CRP1 > 5, 1, 0),
    CRP_second_visit = if_else(AME_CRP2 > 5, 1, 0),
    CRP_third_visit = if_else(AME_CRP3 > 5, 1, 0)
  )

# Ferritin rescaling (ug/L)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    iron_divided_1 = AME_Ferritine1 / 10,
    iron_divided_2 = AME_Ferritine2 / 10,
    iron_divided_3 = AME_Ferritine3 / 10
  )

# Iron deficiency by visit (based on CRP status)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    ID_visit1 = if_else(iron_divided_1 < 12 | 
                        (CRP_first_visit == 1 & iron_divided_1 >= 12 & iron_divided_1 <= 70), 1, 0),
    ID_visit2 = if_else(iron_divided_2 < 12 |
                        (CRP_second_visit == 1 & iron_divided_2 >= 12 & iron_divided_2 <= 70), 1, 0),
    ID_visit3 = if_else(iron_divided_3 < 12 |
                        (CRP_third_visit == 1 & iron_divided_3 >= 12 & iron_divided_3 <= 70), 1, 0),
    iron_def_total = case_when(
      ID_visit1 == 1 | ID_visit2 == 1 | ID_visit3 == 1 ~ 1,
      ID_visit1 == 0 & ID_visit2 == 0 & ID_visit3 == 0 ~ 0,
      TRUE ~ NA_real_
    )
  )

# ------------------------------------------------------------------------------
# Parasitic Infections
# ------------------------------------------------------------------------------

# Hookworm (positive in either Aduo or Name)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(hookworm_visit1 = case_when(
    AME_Aduo1 == 2 | AME_Name1 == 2 ~ 1,
    AME_Aduo1 == 1 & AME_Name1 == 1 ~ 0,
    TRUE ~ NA_real_
  ))

# Helminth infection (Kato test)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(helminth_inf1 = case_when(
    AME_Kato1 == 1 ~ 0,
    AME_Kato1 == 2 ~ 1,
    AME_Kato1 == 3 ~ NA_real_
  ))

# ------------------------------------------------------------------------------
# Household Wealth and Stimulation
# ------------------------------------------------------------------------------

# Wealth index based on basic assets
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    AME_Latrines_recode = ifelse(AME_Latrines == 2, 1, ifelse(AME_Latrines == 1, 0, NA)),
    AME_Electricite_recode = ifelse(AME_Electricite == 2, 1, ifelse(AME_Electricite == 1, 0, NA)),
    AME_Frigo_recode = ifelse(AME_Frigo == 2, 1, ifelse(AME_Frigo == 1, 0, NA)),
    AME_TeleViseur_recode = ifelse(AME_TeleViseur == 2, 1, ifelse(AME_TeleViseur == 1, 0, NA)),
    AME_DeuxRoues_recode = ifelse(AME_DeuxRoues == 2, 1, ifelse(AME_DeuxRoues == 1, 0, NA)),
    richeness_baseline = AME_Latrines_recode + AME_Electricite_recode + AME_Frigo_recode +
                         AME_TeleViseur_recode + AME_DeuxRoues_recode
  )

# Stimulation & maternal mental health (raw scores)
summary(malaria_sdq_pop$TOV_hometot)     # HOME inventory
summary(malaria_sdq_pop$TOV_epdstot)     # EPDS

# ------------------------------------------------------------------------------
# Child Characteristics
# ------------------------------------------------------------------------------

# Preterm birth
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(preterm_birth = case_when(
    v05del_delivgestage_1 < 37 ~ 1,
    v05del_delivgestage_1 >= 37 ~ 0,
    TRUE ~ NA_real_
  ))

# Birthweight
malaria_sdq_pop$MSE_v01bir_bweight_5 <- as.numeric(malaria_sdq_pop$MSE_v01bir_bweight_5)

# Sex
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(child_sex = case_when(
    MSE_v01bir_sex_4 == "Female" ~ "Female",
    MSE_v01bir_sex_4 == "Male" ~ "Male",
    MSE_v01bir_sex_4 == ".disc" ~ NA_character_
  ))

# ------------------------------------------------------------------------------
# Malaria Exposure Variants (Covariates/Exploratory)
# ------------------------------------------------------------------------------

# Pre-birth malaria (first or second prenatal visits)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(malaria_pre_birth = case_when(
    ANV1_malaria == 1 | ANV2_malaria == 1 ~ 1,
    ANV1_malaria == 0 & (is.na(ANV2_malaria) | ANV2_malaria == 0) ~ 0
  ))

# Birth malaria (excluding placenta)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(birth_malaria = case_when(
    ANV3_malaria == 1 | PCR_malaria == 1 ~ 1,
    (ANV3_malaria == 0 | is.na(ANV3_malaria)) & 
      (PCR_malaria == 0 | is.na(PCR_malaria)) ~ 0,
    TRUE ~ NA_real_
  ))

# Emergency visits: recode NA as 0
malaria_sdq_pop$malaria_emerg <- ifelse(is.na(malaria_sdq_pop$malaria_emerg), 0, malaria_sdq_pop$malaria_emerg)

# Number of exposures (sum)
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(malaria_dose = rowSums(across(
    c(ANV1_malaria, ANV2_malaria, birth_malaria, malaria_emerg, PCR_malaria, PCR_placenta),
    ~ replace_na(.x, 0)
  )))

# Categorized malaria frequency
malaria_sdq_pop <- malaria_sdq_pop %>%
  mutate(
    malaria_dose_3cat = case_when(
      malaria_dose == 0 ~ "0",
      malaria_dose == 1 ~ "1",
      malaria_dose >= 2 ~ "2+",
      TRUE ~ NA_character_
    ),
    malaria_dose_4cat = case_when(
      malaria_dose == 0 ~ "0",
      malaria_dose == 1 ~ "1",
      malaria_dose == 2 ~ "2",
      malaria_dose >= 3 ~ "3+",
      TRUE ~ NA_character_
    ),
    malaria_dose_5cat = case_when(
      malaria_dose == 0 ~ "0",
      malaria_dose == 1 ~ "1",
      malaria_dose == 2 ~ "2",
      malaria_dose == 3 ~ "3",
      malaria_dose >= 4 ~ "4+",
      TRUE ~ NA_character_
    )
  )

malaria_sdq_pop$malaria_dose_3cat <- factor(malaria_sdq_pop$malaria_dose_3cat, levels = c("0", "1", "2+"))
malaria_sdq_pop$malaria_dose_4cat <- factor(malaria_sdq_pop$malaria_dose_4cat, levels = c("0", "1", "2", "3+"))
malaria_sdq_pop$malaria_dose_5cat <- factor(malaria_sdq_pop$malaria_dose_5cat, levels = c("0", "1", "2", "3", "4+"))

# ------------------------------------------------------------------------------
# Save Final Dataset
# ------------------------------------------------------------------------------

write.csv(malaria_sdq_pop, "malaria_sdq_pop.csv", row.names = FALSE)
